{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powersnexus.dev/schemas/update-manifest-v1.json",
  "title": "PowersNexus Update Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "version", "channel", "protocolVersion", "minimumNovaWayVersion", "maximumNovaWayVersion", "sourceCommit", "artifactUrl", "artifactSha256", "filesSha256", "artifactSize", "fileCount", "publishedAt", "keyID"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "version": { "type": "string" },
    "channel": { "enum": ["stable", "preview"] },
    "protocolVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "minimumNovaWayVersion": { "type": "string" },
    "maximumNovaWayVersion": { "type": "string" },
    "sourceCommit": { "type": "string", "pattern": "^[a-fA-F0-9]{40}$" },
    "artifactUrl": { "type": "string", "pattern": "^https://" },
    "artifactSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "filesSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "artifactSize": { "type": "integer", "minimum": 1 },
    "fileCount": { "type": "integer", "minimum": 1 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "keyID": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,128}$" },
    "signature": { "type": "string", "contentEncoding": "base64" }
  },
  "additionalProperties": false
}
