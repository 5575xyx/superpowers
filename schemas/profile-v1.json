{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powersnexus.dev/schemas/profile-v1.json",
  "title": "PowersNexus Delivery Profile v1",
  "type": "object",
  "required": ["schemaVersion", "id", "displayName", "requiredSteps"],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "displayName": { "type": "string", "minLength": 1 },
    "requiredSteps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "runnerOwnedSteps": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    }
  },
  "additionalProperties": false
}
