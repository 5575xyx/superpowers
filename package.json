{
  "name": "powersnexus",
  "version": "1.0.0",
  "description": "PowersNexus skills and runtime bootstrap for coding agents",
  "type": "module",
  "main": ".opencode/plugins/powersnexus.js",
  "bin": {
    "powersnexus": "./src/cli/powersnexus-cli.js"
  },
  "keywords": [
    "pi-package",
    "skills",
    "tdd",
    "debugging",
    "collaboration",
    "workflow"
  ],
  "pi": {
    "extensions": [
      "./.pi/extensions/powersnexus.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "devDependencies": {
    "tsx": "^4.22.4"
  },
  "scripts": {
    "test": "npm run test:core",
    "test:core": "node tests/run-tests.mjs",
    "test:uiux": "node --test tests/ui-ux-pro-max.test.mjs",
    "test:platform": "bash tests/run-platform-tests.sh",
    "test:package": "node --test tests/package-artifact.test.mjs",
    "test:hermes": "python -m pytest tests/hermes",
    "release:build": "node scripts/build-release-artifact.mjs",
    "release:sign": "node scripts/sign-release-manifest.mjs",
    "test:all": "npm run test:core && npm run test:uiux && npm run test:platform && npm run test:package"
  }
}
